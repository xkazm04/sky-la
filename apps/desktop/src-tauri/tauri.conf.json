{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sky-la",
  "version": "0.1.0",
  "identifier": "app.skyla.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "sky-la",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "AGPL-3.0-or-later",
    "publisher": "sky-la contributors",
    "category": "Finance",
    "shortDescription": "Local-first, encrypted accounting for Czech freelancers",
    "longDescription": "Double-entry books, invoices, bank statements and Czech tax returns for an OSVČ or a micro-company, encrypted on your computer. Advisors run through your own Claude Code and only propose; nothing posts without you.",
    "copyright": "© 2026 sky-la contributors · AGPL-3.0-or-later",
    "homepage": "https://github.com/xkazm04/sky-la",
    "licenseFile": "../../../LICENSE",
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
